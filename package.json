{
  "name": "tomurai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-baseline.mjs",
    "typecheck": "npm run typecheck --workspace @tomurai/mobile",
    "web": "npm run web --workspace @tomurai/mobile",
    "android:preview": "powershell -NoProfile -File scripts/start-android-preview.ps1",
    "build:web": "npm run build:web --workspace @tomurai/mobile"
  }
}
